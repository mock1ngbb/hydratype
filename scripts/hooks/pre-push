#!/usr/bin/env bash
# hydratype pre-push — TRACKED, reproducible. Runs the portable erebus deck check.
#
# core.hooksPath points at scripts/hooks (set by scripts/install-git-hooks.sh),
# so a clone that runs the installer gets this hook. Landing is trunkq; there is
# no cicada policy layer here any more.
#
# stygian-hooks-install composes its managed block into the EFFECTIVE hook, so
# re-running it after the hooksPath change puts that block at the top of this
# file. That is expected; do not hand-edit the managed block.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Only checks every host can run belong here. The Swift gate (scripts/gate.sh) needs
# full Xcode, which no host has (laptop, mini, MSI), so a pre-push that ran it refused
# every push: a dead gate. It runs in scripts/verify.sh, which reports could-not-run
# (exit 2) when Xcode is absent instead of blocking the push.
if ! bash "$ROOT/scripts/check-erebus-sync.sh"; then
  echo "[pre-push] scripts/check-erebus-sync.sh FAILED — fix before pushing." >&2
  exit 1
fi
