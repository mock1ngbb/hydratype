{
  "version": "1",
  "owner": "mock1ngbb",
  "repo": "hydratype",
  "targets": [
    {
      "platform": "script",
      "service_id": "script:hydratype-gate:production",
      "build": {
        "install_cmd": "true",
        "build_cmd": "bash scripts/gate.sh"
      },
      "artifact": {
        "type": "none"
      },
      "health_check": {
        "url": "https://cicd-queue.mock1ng.workers.dev/v1/queue/status",
        "timeout_seconds": 30,
        "retry_count": 3,
        "expected_status": 200
      },
      "rollback_strategy": "manual",
      "watch_paths": ["**"],
      "deploy_branch": "hee-haw",
      "destructive_gate": false,
      "max_deploy_time_seconds": 900,
      "concurrent_deploys": "serial"
    }
  ],
  "secrets": [],
  "env": {}
}
